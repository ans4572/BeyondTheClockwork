# Not part of the game: kept out of the Cloudflare upload.
.git
.github
node_modules
test
scripts
docs
.scratch
*.md
wrangler.toml
package.json
package-lock.json
worker
# Art sources the game never fetches (it loads the WebP sheets and the finished marks): the PNG masters of every
# animation sheet, the mark sources and their prompts, and the reference picture used to paint the maps.
art/animations/**/*.png
art/fx/marks/src
art/chapters/*/hazards/src
art/world-map/smile-street-road-reference.png
*.prompt.txt
*-submission.txt
# The key art masters (the page shares the 1200×630 JPEG only).
art/ui/key-art/*.png
art/ui/key-art/key-art-v1.jpg
# The story-scene PNG masters (the game loads the WebP).
art/scenes/**/*.png
# Local tool settings (Claude's preview launcher).
.claude
# Kept in the repository but no longer used by the game (2026-11-10): the ESRGAN village picture (the game draws the
# original with hard pixels) and two title songs the game went back from (it plays title.ogg).
art/chapters/1-smile-street/maps/00-village-court/background-esr2x-q92.webp
# The court's 1920x1280 painting shown with hard pixels until 2026-11-14 (the game now loads background-v8-2x-q92.webp).
art/chapters/1-smile-street/maps/00-village-court/background-v7-q92.webp
art/audio/bgm/title-v2.ogg
art/audio/bgm/title-v3.ogg
# The packed site tried on this computer (scripts/build.mjs without --deploy; the build machine writes index.html).
index.built.html

# Chapter 3 mob preview page (local only, sheets rebuilt by scripts/build-ch3-mob-preview.py).
art/chapters/3-clock-tower/mobs/preview

# Belgard preview page (local only, sheets rebuilt from the PixelLab zip and the game clips).
art/chapters/3-clock-tower/bosses/belgard/preview
art/chapters/3-clock-tower/bosses/belgard/fx/src

# Orden preview page (local only, sheets rebuilt by scripts/build-orden-preview.py), and the raw PixelLab review sheets.
art/chapters/3-clock-tower/bosses/orden/preview
art/chapters/3-clock-tower/bosses/orden/pixellab/review

# Chapter 3's first songs, replaced by the -v2 ones (2026-11-19).
art/audio/bgm/tower.ogg
art/audio/bgm/tower-rest.ogg
art/audio/bgm/ticktock.ogg
art/audio/bgm/belgard.ogg

# Chapter 3's sound and effect preview page (local only; screenshots of the game and buttons for src/audio/clock-sound.js).
art/chapters/3-clock-tower/sfx-preview

# The liberation cutscene's painted versions (v1, v2, 2026-11-19/20): the cutscene now draws the maps and the game's own sprites
# (src/ui/liberation-cutscene.js), so none of these is fetched. Only tower-far's painting (webp) and hands are (2026-11-20).
art/scenes/liberation/v2
art/scenes/liberation/inputs
art/scenes/liberation/inputs-v2
art/scenes/liberation/liberation-*
art/scenes/liberation/*.md
art/scenes/liberation/tower-far/*.md
art/scenes/liberation/tower-far/*.txt
art/scenes/liberation/tower-far/*.js
art/scenes/liberation/tower-far/ref-*
art/scenes/liberation/tower-far/candidates
art/scenes/liberation/tower-far/tower-far-v1.png
# The script that painted the summit floor over its pit (2026-11-21): a source, never fetched.
art/chapters/3-clock-tower/maps/11-ruined-summit/floor-fill-v4.py
# Chapter 3's unwind props, drawn in code (2026-11-21); the script is a source, not an asset.
art/fx/boss-unwind-props-ch3.py
art/chapters/3-clock-tower/bosses/orden/fx/src/od-hand.py
art/chapters/3-clock-tower/bosses/orden/fx/src/od-watch.py

