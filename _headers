# Cloudflare headers. One Cache-Control per path group, so the rules do not stack.

# Pages, code and data: checked on every visit (a cheap 304 when unchanged), so a deploy shows at once.
/
  Cache-Control: public, max-age=0, must-revalidate
/*.html
  Cache-Control: public, max-age=0, must-revalidate
/src/*
  Cache-Control: public, max-age=0, must-revalidate
/concepts/*
  Cache-Control: public, max-age=0, must-revalidate

# Art, fonts and sound: a returning visit shows the copy it has at once and checks for a newer one in the background
# (stale-while-revalidate), instead of waiting on hundreds of checks before the first frame. Redrawn art gets a new file
# name, so a replaced picture is never stuck; one replaced in place shows the old copy for one visit at most.
/art/*
  Cache-Control: public, max-age=60, stale-while-revalidate=604800

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
