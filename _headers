# Cloudflare headers. One Cache-Control per path group, so the rules do not stack.

# Pages, code and data: checked on every visit (a cheap 304 when unchanged), so a deploy shows at once.
/
  Cache-Control: public, max-age=0, must-revalidate
/*.html
  Cache-Control: public, max-age=0, must-revalidate
/src/*
  Cache-Control: public, max-age=0, must-revalidate
/concepts/*
  Cache-Control: public, max-age=0, must-revalidate

# Art, fonts and sound change rarely and are large: keep them a day, refresh in the background after that.
/art/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
