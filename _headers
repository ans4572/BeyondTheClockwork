# Cloudflare headers. One Cache-Control per path group, so the rules do not stack.

# Pages, code and data: checked on every visit (a cheap 304 when unchanged), so a deploy shows at once.
/
  Cache-Control: public, max-age=0, must-revalidate
/*.html
  Cache-Control: public, max-age=0, must-revalidate
/src/*
  Cache-Control: public, max-age=0, must-revalidate
/concepts/*
  Cache-Control: public, max-age=0, must-revalidate

# Art, fonts and sound: also checked on every visit. They are still redrawn often, and a day-old copy kept showing
# replaced mobs and maps; an unchanged file costs only a 304. Loaded images stay in the page's memory meanwhile.
/art/*
  Cache-Control: public, max-age=0, must-revalidate

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
