# Cloudflare headers. One Cache-Control per path group, so the rules do not stack.

# Pages, code and data: checked on every visit (a cheap 304 when unchanged), so a deploy shows at once.
/
  Cache-Control: public, max-age=0, must-revalidate
/*.html
  Cache-Control: public, max-age=0, must-revalidate
/src/*
  Cache-Control: public, max-age=0, must-revalidate
/concepts/*
  Cache-Control: public, max-age=0, must-revalidate

# Art, fonts and sound: kept a day without asking (2026-11-13, was a minute), then shown at once while a newer copy is
# checked for in the background (stale-while-revalidate, 30 days), instead of waiting on hundreds of checks before the
# first frame. Redrawn art gets a new file name, so a replaced picture is never stuck; one replaced in place under the same
# name shows the old copy for a day at most (and sw.js keeps it longer: give it a new name). The .json lists under /art/
# (game-clips.json, art/atlases/index.json) are fetched with cache: 'no-cache', so they are checked on every visit.
/art/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=2592000

# Atlas pages carry their contents' hash in their names: a page never changes, so it is kept a year (index.json is
# fetched with cache: 'no-cache' and so still checked every visit).
/art/atlases/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

# The service worker itself is checked on every visit, so switching it off (sw.js KILL) reaches every device.
/sw.js
  Cache-Control: public, max-age=0, must-revalidate

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
