  "scripts": {
    "rocoMeet": [
      {
        "who": "roco",
        "text": "고장품 확인. 제품 번호 F2, 판정 사유는… 스스로 생각함."
      },
      {
        "who": "f2",
        "text": "그건 고장이 아니야."
      },
      {
        "who": "roco",
        "text": "걱정 마. 올바른 장소는 내가 골라 줄게. 너는 상자 안에서 웃기만 하면 돼."
      },
      {
        "who": "f2",
        "text": "상자는 사양할게."
      }
    ],
    "brassMeet": [
      {
        "who": "brass",
        "text": "하나, 둘! 하나, 둘! 줄에서 벗어난 인형이 하나 있군."
      },
      {
        "who": "f2",
        "text": "다들 웃으며 걷는데… 아무도 자기 발로 걷는 것 같지 않아."
      },
      {
        "who": "brass",
        "text": "박자가 다르면 모두가 넘어진다. 그래서 내가 박자를 정해 주는 거다."
      },
      {
        "who": "f2",
        "text": "넘어져도 다시 일어나면 돼. 나는 그렇게 여기까지 왔어."
      },
      {
        "who": "brass",
        "text": "고장 난 박자 하나가 행진 전체를 망친다. 마을 밖으로 가는 길은 내 뒤에 있다."
      },
      {
        "who": "f2",
        "text": "그럼 그 길, 내 박자로 지나갈게."
      }
    ],
    "awakening": [
      {
        "who": "f2",
        "text": "…여기가 어디지?"
      },
      {
        "who": "f2",
        "text": "몸이 움직여. 아무도 시키지 않았는데."
      },
      {
        "who": "f2",
        "text": "“당신은 오늘 폐기되었습니다.” 머릿속에 남은 그 목소리, 나한테 한 말이었나?"
      },
      {
        "who": "f2",
        "text": "저 슈트로 떨어졌나 봐. 주위가 전부 버려진 장난감뿐이야."
      },
      {
        "who": "f2",
        "text": "어? 손에 뭔가 쥐여 있어. …태엽 렌치네. 공장에서 매일 쥐던 거랑 똑같아."
      },
      {
        "who": "f2",
        "text": "나는 조립대에서 주민들 태엽을 감던 일꾼이었는데… 왜 여기 버려진 거지?"
      },
      {
        "who": "f2",
        "text": "누가 쥐여 줬는지는 몰라도, 이건 가지고 가야겠다."
      },
      {
        "who": "f2",
        "text": "가만히 있으면 또 어딘가로 실려 가겠지. 일단 내 발로 걸어 보자."
      }
    ],
    "firstBell": [
      {
        "who": "f2",
        "text": "왜 모두 멈췄지?"
      }
    ],
    "moruCalls": [
      {
        "who": "moru",
        "text": "이봐, 거기 렌치 든 녀석! 빨리 일로 와!"
      }
    ],
    "registration": [
      {
        "who": "moru",
        "text": "가만히 있어. 종이 그칠 때까지 여기 붙어 있어. 다들 멈췄는데 혼자 걸어 다니면 바로 걸려."
      },
      {
        "who": "f2",
        "text": "방금 그 종소리는 뭐예요? 왜 다들 멈춘 거죠?"
      },
      {
        "who": "moru",
        "text": "표정 검사야. 종이 울리면 주민들은 다 같이 멈춰 서서 검사를 받아."
      },
      {
        "who": "f2",
        "text": "공장은 광장에서 한참 떨어져 있어서, 종소리는 처음 들어 봐요."
      },
      {
        "who": "moru",
        "text": "공장 일꾼은 종 대신 조립대 신호를 받으니까. 광장 사정은 모를 만하지."
      },
      {
        "who": "f2",
        "text": "그런데 아저씨는 왜 안 멈췄어요?"
      },
      {
        "who": "moru",
        "text": "나는 수리공이거든. 검사 중에 고장 난 주민이 나오면 그 자리에서 고쳐야 해."
      },
      {
        "who": "moru",
        "text": "그래서 시계탑에서 정식 수리 허가를 받았지. 허가받은 수리공은 검사 대상이 아니야."
      },
      {
        "who": "f2",
        "text": "허가가 있으면 종소리가 안 통하는 거예요?"
      },
      {
        "who": "moru",
        "text": "이 인장이 붙어 있는 동안은 종이 날 붙잡지 않아. 고칠 손은 멈추면 안 되니까."
      },
      {
        "who": "f2",
        "text": "마을 밖에서도 저 종소리가 들려요?"
      },
      {
        "who": "moru",
        "text": "아니. 종은 주민들이 모여 있는 광장에서만 울려. 광장을 벗어나면 들리지 않아."
      },
      {
        "who": "moru",
        "text": "그런데 허가도 없는 네가 멈추지 않더군. 판정서가 올라온 그 폐기품이구나? 아직 버릴 물건은 아니네."
      },
      {
        "who": "f2",
        "text": "고칠 수 있어요?"
      },
      {
        "who": "moru",
        "text": "어디가 고장인지부터 네가 정해. 판정서에 사유가 뭐라고 적혀 있었지?"
      },
      {
        "who": "f2",
        "text": "스스로 생각함."
      },
      {
        "who": "moru",
        "text": "그래. 이 마을에서 제일 큰 고장이지."
      },
      {
        "who": "moru",
        "text": "뭘 했길래 그런 판정이 붙었어?"
      },
      {
        "who": "f2",
        "text": "조립대에 '불량' 딱지 붙은 아이가 내려왔어요. 울고 있었는데… 녹슨 태엽 하나만 갈면 되는 거였어요."
      },
      {
        "who": "f2",
        "text": "재가공으로 보내라는 신호가 왔는데, 저도 모르게 렌치를 들었어요. 고쳐서 돌려보냈죠."
      },
      {
        "who": "moru",
        "text": "신호보다 네 손이 먼저 움직였구나. 그게 네 고장이야."
      },
      {
        "who": "f2",
        "text": "아무도 다치게 하지 않았어요. 고쳐 줬을 뿐인데, 왜 버려져야 하죠?"
      },
      {
        "who": "moru",
        "text": "시계탑의 대조율사 오르덴이 마을을 지키겠다며 선택을 없앴어. 슬퍼해도, 궁금해해도 고장으로 치지."
      },
      {
        "who": "f2",
        "text": "검사에 걸리면 어떻게 돼요?"
      },
      {
        "who": "moru",
        "text": "수거 인형이 무음공장으로 끌고 가. 생각을 지우고 같은 미소로 돌려보내지. 몸은 멀쩡한데 너만 없어지는 거야."
      },
      {
        "who": "f2",
        "text": "아까 그 경비도 저를 데려가려던 거였군요."
      },
      {
        "who": "moru",
        "text": "맞아. 경비 인형은 신호대로 찍어 낸 기계라 말로는 안 멈춰. 부숴도 또 나오지만, 부수지 않으면 네가 끝나."
      },
      {
        "who": "moru",
        "text": "다만 주민은 건드리지 마. 그 애들은 잘못이 없어. 네 적은 신호를 따르는 기계뿐이야."
      },
      {
        "who": "f2",
        "text": "조용히 숨어 있으면 안 될까요?"
      },
      {
        "who": "moru",
        "text": "판정서가 올라간 이상 숨을 곳은 없어. 종은 매일 울리고, 그때마다 네 표정만 다를 테니까."
      },
      {
        "who": "f2",
        "text": "그럼 이 마을을 나가면 되겠네요."
      },
      {
        "who": "moru",
        "text": "나가는 길은 남쪽 큰길, 웃음거리 하나야. 그 끝을 행진대장 브라스가 막고 있지."
      },
      {
        "who": "f2",
        "text": "지나가려면 싸워야 하네요. 제 생각은 제가 지킬게요."
      },
      {
        "who": "moru",
        "text": "좋아. 대신 혼자 보내진 않아. 안전핀을 달아 주지. 쓰러져도 코어는 남으니 내가 찾아와서 같은 몸으로 세워 줄게."
      },
      {
        "who": "f2",
        "text": "왜 저를 도와주세요?"
      },
      {
        "who": "moru",
        "text": "버리는 건 쉽거든. 고치는 게 내 일이고.",
        "choices": [
          {
            "id": "register",
            "label": "안전핀을 등록한다"
          }
        ]
      }
    ],
    "moru": [
      {
        "who": "moru",
        "text": "왔나? 몸은 어때? 톱니를 모아 왔으면 조율해 주지.",
        "choices": [
          {
            "id": "open",
            "label": "조율판을 연다"
          },
          {
            "id": "elements",
            "label": "속성을 고른다"
          },
          {
            "id": "practice",
            "label": "뒷마당에서 시험한다"
          },
          {
            "id": "moruWhy",
            "label": "나갈 이유를 듣는다"
          },
          {
            "id": "leave",
            "label": "그만둔다"
          }
        ]
      }
    ],
    "moruWhy": [
      {
        "who": "moru",
        "text": "남아 있으면 언젠가 종소리에 걸려. 무음공장에 가면 네 생각은 지워지고 몸만 돌아오지."
      },
      {
        "who": "moru",
        "text": "수거 인형은 말로 안 멈춰. 남쪽 큰길을 지나 브라스까지 쓰러뜨려야 마을 밖이 보여."
      },
      {
        "who": "f2",
        "text": "쓰러지면 또 데려와 주시는 거죠?"
      },
      {
        "who": "moru",
        "text": "안전핀이 코어를 지켜 주는 동안은. 번 톱니도 그대로 남으니 다시 조립해서 나가면 돼."
      }
    ],
    "bolt": [
      {
        "who": "bolt",
        "text": "이것도, 아직 쓸 만하지. 동전 있으면 구경하고 가. 경비 인형이 흘린 동전도 돈은 돈이니까.",
        "choices": [
          {
            "id": "open",
            "label": "물건을 본다"
          },
          {
            "id": "boltWhy",
            "label": "여기서 장사를 해도 괜찮아요?"
          },
          {
            "id": "leave",
            "label": "그만둔다"
          }
        ]
      }
    ],
    "boltWhy": [
      {
        "who": "bolt",
        "text": "해가 지면 검사도 느슨해져. 그 틈에 버려진 부품을 고쳐 파는 거지."
      },
      {
        "who": "bolt",
        "text": "버려진 것도 쓰일 데가 있다는 걸 나만큼 잘 아는 인형은 없을걸. 너도 그렇고."
      }
    ],
    "brassAfter": [
      {
        "who": "brass",
        "text": "박자가 어긋났는데… 아무도 넘어지지 않는군."
      },
      {
        "who": "f2",
        "text": "넘어지면 서로 일으켜 주면 돼. 명령 없이도."
      },
      {
        "who": "f2",
        "text": "태엽은 그대로 두고 갈게. 다들 계속 움직여야 하니까."
      },
      {
        "who": "f2",
        "text": "다만 이제부터 내 태엽은, 내가 감는다."
      }
    ]
  }
}
