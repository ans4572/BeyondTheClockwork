  "scripts": {
    "rocoMeet": [
      {
        "who": "roco",
        "text": "고장품 확인. 제품 번호 F2, 판정 사유는… 스스로 생각함."
      },
      {
        "who": "f2",
        "text": "그건 고장이 아니야."
      },
      {
        "who": "roco",
        "text": "걱정 마. 올바른 장소는 내가 골라 줄게. 너는 상자 안에서 웃기만 하면 돼."
      },
      {
        "who": "f2",
        "text": "상자는 사양할게."
      }
    ],
    "brassMeet": [
      {
        "who": "brass",
        "text": "하나, 둘! 하나, 둘! 줄에서 벗어난 인형이 하나 있군."
      },
      {
        "who": "f2",
        "text": "다들 웃으며 걷는데… 아무도 자기 발로 걷는 것 같지 않아."
      },
      {
        "who": "brass",
        "text": "박자가 다르면 모두가 넘어진다. 그래서 내가 박자를 정해 주는 거다."
      },
      {
        "who": "f2",
        "text": "넘어져도 다시 일어나면 돼. 나는 그렇게 여기까지 왔어."
      },
      {
        "who": "brass",
        "text": "고장 난 박자 하나가 행진 전체를 망친다. 마을 밖으로 가는 길은 내 뒤에 있다."
      },
      {
        "who": "f2",
        "text": "그럼 그 길, 내 박자로 지나갈게."
      }
    ],
    "awakening": [
      {
        "who": "f2",
        "text": "…여기가 어디지?"
      },
      {
        "who": "f2",
        "text": "몸이 움직여. 아무도 시키지 않았는데."
      },
      {
        "who": "f2",
        "text": "“당신은 오늘 폐기되었습니다.” 머릿속에 남은 그 목소리, 나한테 한 말이었나?"
      },
      {
        "who": "f2",
        "text": "저 슈트로 떨어졌나 봐. 주위가 전부 버려진 장난감뿐이야."
      },
      {
        "who": "f2",
        "text": "어? 손에 뭔가 쥐여 있어. …태엽 렌치네. 공장에서 매일 쥐던 거랑 똑같아."
      },
      {
        "who": "f2",
        "text": "나는 조립대에서 주민들 태엽을 감던 일꾼이었는데… 왜 여기 버려진 거지?"
      },
      {
        "who": "f2",
        "text": "누가 쥐여 줬는지는 몰라도 이건 가지고 가야겠다."
      },
      {
        "who": "f2",
        "text": "가만히 있으면 또 어딘가로 실려 가겠지. 일단 내 발로 걸어 보자."
      }
    ],
    "firstBell": [
      {
        "who": "f2",
        "text": "왜 모두 멈췄지?"
      }
    ],
    "moruCalls": [
      {
        "who": "moru",
        "text": "이봐, 거기 렌치 든 녀석! 빨리 일로 와!"
      }
    ],
    "ledger": [
      {
        "who": "moru",
        "text": "고치기 전에 수리 장부부터 적어야지. 번호 말고, 장부에 적을 이름을 알려 줘."
      },
      {
        "who": "f2",
        "text": "이름이요? 공장에선 번호로만 불렸는데…",
        "ask": { "id": "nickname", "label": "장부에 적을 이름", "placeholder": "F2", "submit": "장부에 적기", "note": "비워 두면 F2로 적혀요. 나중에 설정에서 바꿀 수 있어요." }
      }
    ],
    "ledgerDone": [
      {
        "who": "f2",
        "text": "{name|이라고|라고} 불러 주세요."
      },
      {
        "who": "moru",
        "text": "{name}. 좋아, 장부에 적었다. 자, 안전핀부터 달자."
      }
    ],
    "registration": [
      {
        "who": "moru",
        "text": "쉿, 가만히 있어. 종이 그칠 때까지 여기 붙어 있어. 다들 멈췄는데 혼자 걸으면 바로 눈에 띄어."
      },
      {
        "who": "f2",
        "text": "방금 그 종소리는 뭐예요? 왜 다들 멈춘 거죠?"
      },
      {
        "who": "moru",
        "text": "표정 검사야. 종이 울리면 주민들은 그 자리에 서서 같은 미소를 짓고 검사를 받아."
      },
      {
        "who": "moru",
        "text": "종은 주민들이 모이는 광장에서만 울려. 공장 일꾼이었다면 처음 들어 봤겠군."
      },
      {
        "who": "f2",
        "text": "네, 공장에선 조립대 신호만 들었어요. 그런데 아저씨는 왜 안 멈췄어요?"
      },
      {
        "who": "moru",
        "text": "난 수리공이라 시계탑의 수리 인장을 받았거든. 검사 중에 고장 난 주민을 고치려면 손이 움직여야 하니까."
      },
      {
        "who": "moru",
        "text": "그런데 인장도 없는 네가 멈추지 않더군. 판정서가 올라온 그 폐기품이 너구나?"
      },
      {
        "who": "f2",
        "text": "…네. 판정 사유는 '스스로 생각함'이래요."
      },
      {
        "who": "moru",
        "text": "이 마을에서 제일 큰 고장이지. 무슨 일이 있었길래?"
      },
      {
        "who": "f2",
        "text": "조립대에 '불량' 딱지가 붙은 아이가 내려왔어요. 녹슨 태엽 하나만 갈면 되는 거였어요."
      },
      {
        "who": "f2",
        "text": "재가공으로 보내라는 신호가 왔는데, 저도 모르게 렌치를 들고 고쳐서 돌려보냈어요."
      },
      {
        "who": "moru",
        "text": "신호보다 네 손이 먼저 움직였구나. 시계탑은 그걸 고장이라고 불러."
      },
      {
        "who": "f2",
        "text": "고쳐 줬을 뿐인데요. 왜 그게 고장이에요?"
      },
      {
        "who": "moru",
        "text": "시계탑의 대조율사 오르덴이 마을을 지킨다며 선택을 없앴어. 슬퍼해도, 궁금해해도 고장으로 치지."
      },
      {
        "who": "f2",
        "text": "검사에 걸리면 어떻게 돼요?"
      },
      {
        "who": "moru",
        "text": "수거 인형이 무음공장으로 끌고 가. 생각을 지우고 같은 미소로 돌려보내지. 몸은 그대로인데 너만 없어져."
      },
      {
        "who": "f2",
        "text": "아까 그 경비도 저를 데려가려던 거였군요."
      },
      {
        "who": "moru",
        "text": "맞아. 경비 인형은 신호대로 움직이는 기계라 말로는 안 멈춰. 다만 주민은 건드리지 마. 그 애들은 잘못이 없어."
      },
      {
        "who": "f2",
        "text": "조용히 숨어 지내면 안 될까요?"
      },
      {
        "who": "moru",
        "text": "판정서가 올라간 이상 숨을 곳은 없어. 종은 매일 울리고, 그때마다 너만 표정이 다를 테니까."
      },
      {
        "who": "f2",
        "text": "그럼 마을을 나가야겠네요."
      },
      {
        "who": "moru",
        "text": "나가는 길은 남쪽 큰길, 웃음거리 하나야. 그 끝을 행진대장 브라스가 막고 있지."
      },
      {
        "who": "f2",
        "text": "싸워서라도 지나갈게요. 제 생각은 제가 지킬래요."
      },
      {
        "who": "moru",
        "text": "좋아. 대신 맨몸으론 안 보내. 안전핀을 달아 주지. 쓰러져도 코어만 남으면 내가 찾아가 다시 세워 줄게."
      },
      {
        "who": "f2",
        "text": "처음 보는 저를… 왜 도와주세요?"
      },
      {
        "who": "moru",
        "text": "나도 수리공이라서. 고칠 수 있는 걸 버리는 건 못 보거든.",
        "choices": [
          {
            "id": "register",
            "label": "안전핀을 등록한다"
          }
        ]
      }
    ],
    "moru": [
      {
        "who": "moru",
        "text": "왔나? 몸은 어때? 톱니를 모아 왔으면 조율해 주지.",
        "choices": [
          {
            "id": "open",
            "label": "조율판을 연다"
          },
          {
            "id": "elements",
            "label": "속성 부품을 본다"
          },
          {
            "id": "practice",
            "label": "뒷마당에서 시험한다"
          },
          {
            "id": "moruWhy",
            "label": "나갈 이유를 듣는다"
          },
          {
            "id": "leave",
            "label": "그만둔다"
          }
        ]
      }
    ],
    "moruWhy": [
      {
        "who": "moru",
        "text": "남아 있으면 언젠가 종소리에 걸려. 무음공장에 가면 네 생각은 지워지고 몸만 돌아오지."
      },
      {
        "who": "moru",
        "text": "수거 인형은 말로 안 멈춰. 남쪽 큰길을 지나 브라스까지 쓰러뜨려야 마을 밖이 보여."
      },
      {
        "who": "f2",
        "text": "쓰러지면 또 데려와 주시는 거죠?"
      },
      {
        "who": "moru",
        "text": "안전핀이 코어를 지켜 주는 동안은. 번 톱니도 그대로 남으니 다시 조립해서 나가면 돼."
      }
    ],
    "bolt": [
      {
        "who": "bolt",
        "text": "이것도, 아직 쓸 만하지. 동전 있으면 구경하고 가. 경비 인형이 흘린 동전도 돈은 돈이니까.",
        "choices": [
          {
            "id": "open",
            "label": "물건을 본다"
          },
          {
            "id": "boltWhy",
            "label": "여기서 장사를 해도 괜찮아요?"
          },
          {
            "id": "leave",
            "label": "그만둔다"
          }
        ]
      }
    ],
    "boltWhy": [
      {
        "who": "bolt",
        "text": "해가 지면 검사도 느슨해져. 그 틈에 버려진 부품을 고쳐 파는 거지."
      },
      {
        "who": "bolt",
        "text": "버려진 것도 쓰일 데가 있다는 걸 나만큼 잘 아는 인형은 없을걸. 너만 봐도 그렇잖아."
      }
    ],
    "brassAfter": [
      {
        "who": "brass",
        "text": "…태엽이 감겼군. 그런데 이상하다. 머릿속에서 박자가 들리지 않아."
      },
      {
        "who": "f2",
        "text": "명령 회로만 떼어 냈어. 이제 걸음은 네가 정하면 돼."
      },
      {
        "who": "brass",
        "text": "박자가 어긋났는데… 아무도 넘어지지 않는군."
      },
      {
        "who": "f2",
        "text": "넘어지면 서로 일으켜 주면 돼. 명령 없이도."
      },
      {
        "who": "brass",
        "text": "마을 밖으로 가는 길은 무음공장 너머에 있다. 그 위에는… 시계탑이 있지."
      },
      {
        "who": "f2",
        "text": "그럼 거기까지 갈게. 이제부터 내 태엽은, 내가 감는다."
      }
    ],
    "ordenScene": [
      {
        "who": "belgard",
        "text": "보고드립니다. 웃음거리의 행진 신호가 끊겼습니다."
      },
      {
        "who": "orden",
        "text": "브라스의 박자가 멈췄다는 말이군."
      },
      {
        "who": "belgard",
        "text": "불량 판정을 받은 F2가 통제축을 떼어 냈습니다. 주민 몇이 박자를 놓치고 멈춰 서 있습니다."
      },
      {
        "who": "orden",
        "text": "넘어진 자는?"
      },
      {
        "who": "belgard",
        "text": "…없습니다. 서로 붙잡아 주고 있습니다."
      },
      {
        "who": "orden",
        "text": "그래서 고장은 번지는 거다. 하나가 멈추면, 모두가 왜 걷는지 묻기 시작하지."
      },
      {
        "who": "belgard",
        "text": "종루에서 본신호를 높일까요?"
      },
      {
        "who": "orden",
        "text": "아니. 무음공장을 깨워라. 소리가 없으면, 물음도 없다."
      },
      {
        "who": "orden",
        "text": "그 인형이 공장 문 앞에 서면… 내가 직접 다시 조율하겠다."
      }
    ],
    "firstElement": [
      {
        "who": "moru",
        "text": "잠깐, 하나 더 있다. 렌치 한 자루만 들고 브라스까지 가기엔 길이 너무 멀어."
      },
      {
        "who": "moru",
        "text": "이 선반을 봐. 버려진 인형들에게서 떼어 내 몰래 고쳐 둔 속성 부품들이야."
      },
      {
        "who": "f2",
        "text": "공장에선 이런 걸 본 적이 없어요. 이걸 팔에 다는 거예요?"
      },
      {
        "who": "moru",
        "text": "그래. 부품 하나를 달면 렌치 말고도 기술을 두 가지 더 쓸 수 있어. 처음 하나는 공짜로 달아 주마. 선반에서 골라 봐."
      }
    ],
    "firstElementAfter": [
      {
        "who": "moru",
        "text": "잘 붙었네. 처음엔 어색해도 몇 번 쓰다 보면 네 손처럼 익숙해질 거야."
      },
      {
        "who": "moru",
        "text": "다른 부품은 하나에 톱니 50개야. 원정에서 모아 오면 달아 주지."
      },
      {
        "who": "moru",
        "text": "두 개를 함께 달면 둘을 엮은 융합 기술도 쓸 수 있어."
      },
      {
        "who": "f2",
        "text": "네, 도와주셔서 감사합니다."
      }
    ]
  }
}
